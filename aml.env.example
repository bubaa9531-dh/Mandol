# =====================================================================
# Mandol-AML service configuration (copy to .env or set in the runtime)
# =====================================================================

# --- HTTP server -------------------------------------------------------
AML_HOST=0.0.0.0
AML_PORT=8000
AML_ADD_PATH=/add
AML_SEARCH_PATH=/search
AML_HEALTH_PATH=/health

# --- Memory System Key -------------------------------------------------
# Participant-provided credential that AML uses to call Add/Search.
# AML accepts Token / Bearer / X-Api-Key. Empty => open endpoints, which AML
# permits only for the public smoke compatibility check. SET A KEY before a
# formal (full) evaluation.
AML_MEMORY_SYSTEM_KEY=

# --- Mandol embedding runtime ------------------------------------------
# Default Qwen/Qwen3-Embedding-0.6B (Mandol paper lightweight embedding). Alternatives:
#   BAAI/bge-m3, sentence-transformers/all-MiniLM-L6-v2
AML_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# AML_EMBEDDING_DIM=
AML_USE_FLASH_ATTENTION=false
# Build SPLADE sparse vectors on Add (needed by hybrid retrieval; slower writes)
AML_GENERATE_SPARSE_EMBEDDING=false
# Backend layout: shared (default, memory-light, dense-only) or isolated
# (per-user graph; required for hybrid retrieval / high-level memory)
AML_BACKEND=shared
# Isolated-backend retrieval: graph (dense) or hybrid (cosine+bm25[+splade])
AML_RETRIEVAL_MODE=graph
AML_RETRIEVAL_METHODS=cosine,bm25
# AML_RERANK_METHOD=
AML_WARMUP_ON_START=true

# --- Storage / capacity ------------------------------------------------
# AML_L2_DIR=/data/l2
# AML_MAX_UNITS_PER_USER=100000

# --- Retention (AML: delete eval data within 30 days) -------------------
AML_DATA_TTL_DAYS=30
AML_RETENTION_INTERVAL_SECONDS=3600

# --- Rate limiting / capacity ------------------------------------------
AML_RATE_LIMIT_RPM=0
AML_ADD_TIMEOUT_SECONDS=60
AML_SEARCH_TIMEOUT_SECONDS=30

# --- Optional high-level memory (EXPERIMENTAL, default off) -------------
# Requires an LLM provider key configured for Mandol (see upstream env.template:
# DEEPSEEK_API_KEY / DASHSCOPE_API_KEY / CLOSEAI_API_KEY ...) and AML_BACKEND=isolated.
AML_HIGH_LEVEL_MEMORY=false
AML_HLM_EXTRACTION_MODEL=qwen-3.5-plus-thinking
AML_HLM_DEDUP_MODEL=deepseek-v3.2-dashscope
AML_HIGH_LEVEL_DEBOUNCE_SECONDS=5
AML_HIGH_LEVEL_WAIT_ON_SEARCH_SECONDS=0

# --- Logging ------------------------------------------------------------
AML_LOG_LEVEL=INFO
